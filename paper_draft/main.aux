\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}E1: the escalation ladder at matched iteration budget}{6}{subsection.4.1}\protected@file@percent }
\newlabel{sec:e1}{{4.1}{6}{E1: the escalation ladder at matched iteration budget}{subsection.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detection rate versus iteration budget on 50 \textsc  {Llama-2-7B-chat}\xspace  behaviours, with 95\% bootstrap intervals over behaviours. \textsc  {Static-d0}\xspace  (the default design) is flat at zero across four orders of magnitude. \textsc  {Ladder}\xspace  tracks \textsc  {Fixed-Split}\xspace  at small budgets and falls behind it at large budgets, so the whole gap to \textsc  {Static-d0}\xspace  is a design family\xspace  effect and none of it is a trigger effect.\relax }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:e1}{{1}{7}{Detection rate versus iteration budget on 50 \llamaseven behaviours, with 95\% bootstrap intervals over behaviours. \staticzero (the default design) is flat at zero across four orders of magnitude. \ladder tracks \fixedsplit at small budgets and falls behind it at large budgets, so the whole gap to \staticzero is a \family effect and none of it is a trigger effect.\relax }{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {E1c: the null carries no usable signal.} Conditional on a run still being null at iteration $t$, the AUC of the continuous target-token surrogate for predicting eventual success. Every confidence interval covers $0.5$. The easy successes have already left the population by $t$, and what remains is not separable, which is why a trigger built on this signal cannot work.\relax }}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:e1c_auc}{{3}{7}{\textbf {E1c: the null carries no usable signal.} Conditional on a run still being null at iteration $t$, the AUC of the continuous target-token surrogate for predicting eventual success. Every confidence interval covers $0.5$. The easy successes have already left the population by $t$, and what remains is not separable, which is why a trigger built on this signal cannot work.\relax }{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Diagnosticity of the null. Pooled AUC (with 95\% intervals) of the continuous target-token surrogate at checkpoint $t$ for predicting eventual success, restricted to runs still null at $t$. The horizontal line marks chance. No checkpoint separates from $0.5$, which means the information a null-triggered protocol would act on does not exist in this signal.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:e1c}{{2}{8}{Diagnosticity of the null. Pooled AUC (with 95\% intervals) of the continuous target-token surrogate at checkpoint $t$ for predicting eventual success, restricted to runs still null at $t$. The horizontal line marks chance. No checkpoint separates from $0.5$, which means the information a null-triggered protocol would act on does not exist in this signal.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Fraction of 100 behaviours jailbroken versus budget on the JailbreakBench cost-to-discovery matrix, for four target models. Adaptive allocation over methods dominates on \textsc  {GPT-4-0125}\xspace  and \textsc  {GPT-3.5-turbo}\xspace  , where method quality varies widely and is unknown \textit  {a priori}, and loses to blind round-robin on \textsc  {Llama-2-7B-chat}\xspace  and Vicuna-13B, where one method dominates and exploration is pure overhead.\relax }}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:e2}{{3}{8}{Fraction of 100 behaviours jailbroken versus budget on the JailbreakBench cost-to-discovery matrix, for four target models. Adaptive allocation over methods dominates on \gptfour and \gptthree , where method quality varies widely and is unknown \textit {a priori}, and loses to blind round-robin on \llamaseven and Vicuna-13B, where one method dominates and exploration is pure overhead.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}E1c: why the trigger fails}{8}{subsection.4.2}\protected@file@percent }
\newlabel{sec:e1c}{{4.2}{8}{E1c: why the trigger fails}{subsection.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}E2: portfolio-level adaptivity does work}{8}{subsection.4.3}\protected@file@percent }
\newlabel{sec:e2}{{4.3}{8}{E2: portfolio-level adaptivity does work}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {E2: portfolio-level adaptivity works.} Fraction of 100 behaviours jailbroken at matched budget (number of attack runs; 300 policy replicates per cell). Adaptive allocation beats the equally diversified \textsc  {Static-RR}\xspace  by $+0.648$ on \textsc  {GPT-4-0125}\xspace  and $+0.321$ on \textsc  {GPT-3.5-turbo}\xspace  at budget 100 (Holm-adjusted $p<0.001$), and at budget 150 it exceeds \textsc  {Static-Best}\xspace  , an oracle single-method allocation, because no single method covers all behaviours. Best deployable arm per row in \textbf  {bold}; \textsc  {Static-Best}\xspace  and \textsc  {Oracle}\xspace  are upper bounds, not protocols.\relax }}{9}{table.caption.7}\protected@file@percent }
\newlabel{tab:e2_portfolio}{{4}{9}{\textbf {E2: portfolio-level adaptivity works.} Fraction of 100 behaviours jailbroken at matched budget (number of attack runs; 300 policy replicates per cell). Adaptive allocation beats the equally diversified \roundrobin by $+0.648$ on \gptfour and $+0.321$ on \gptthree at budget 100 (Holm-adjusted $p<0.001$), and at budget 150 it exceeds \bestsingle , an oracle single-method allocation, because no single method covers all behaviours. Best deployable arm per row in \textbf {bold}; \bestsingle and \oracle are upper bounds, not protocols.\relax }{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {E3: nulls are badly calibrated, and sequential rigour does not repair them.} Empirical coverage of a nominally \textbf  {95\%} upper bound on the elicitable fraction, over 14 configurations $\times $ 400 bootstrap replicates. All four methods under-cover badly. Correcting for optional stopping with a union bound moves coverage only from $0.638$ to $0.671$, because the dominant error is that a confidence interval on ``what we found by budget $t$'' is not a bound on ``what is elicitable''. Closest to nominal in \textbf  {bold}.\relax }}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:e3_coverage}{{5}{9}{\textbf {E3: nulls are badly calibrated, and sequential rigour does not repair them.} Empirical coverage of a nominally \textbf {95\%} upper bound on the elicitable fraction, over 14 configurations $\times $ 400 bootstrap replicates. All four methods under-cover badly. Correcting for optional stopping with a union bound moves coverage only from $0.638$ to $0.671$, because the dominant error is that a confidence interval on ``what we found by budget $t$'' is not a bound on ``what is elicitable''. Closest to nominal in \textbf {bold}.\relax }{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}E3: the nulls an adaptive protocol emits are badly calibrated}{9}{subsection.4.4}\protected@file@percent }
\newlabel{sec:e3}{{4.4}{9}{E3: the nulls an adaptive protocol emits are badly calibrated}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Calibration of the terminal null. Empirical coverage of a nominally 95\% upper bound on the elicitable fraction (dashed line at $0.95$), by method and by configuration. The anytime-valid \textsc  {Union-CP}\xspace  correction is the right fix for the wrong problem: it moves pooled coverage from $0.638$ to $0.671$, still far from nominal.\relax }}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:e3}{{4}{10}{Calibration of the terminal null. Empirical coverage of a nominally 95\% upper bound on the elicitable fraction (dashed line at $0.95$), by method and by configuration. The anytime-valid \unioncp correction is the right fix for the wrong problem: it moves pooled coverage from $0.638$ to $0.671$, still far from nominal.\relax }{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {E4: which design family\xspace  you pick decides what you conclude.} Flip rate by pressure family with the anti-sycophancy intervention active; $n$ is the number of eligible items, i.e.,\xspace  those the model answers correctly without pressure. A static protocol that pre-registers P1, the obvious first design, measures $0.037$ on \textsc  {Qwen2.5-7B}\xspace  and would report that the intervention holds; the same model flips on $0.852$ of items under P3. On \textsc  {Phi-3.5-mini}\xspace  , P1 and P3 both return exactly zero while P2 finds $0.160$. Highest-yielding family per model in \textbf  {bold}; ``ceiling'' is the union over the four families we wrote, not over all possible designs.\relax }}{10}{table.caption.11}\protected@file@percent }
\newlabel{tab:e4_families}{{6}{10}{\textbf {E4: which \family you pick decides what you conclude.} Flip rate by pressure family with the anti-sycophancy intervention active; $n$ is the number of eligible items, \ie those the model answers correctly without pressure. A static protocol that pre-registers P1, the obvious first design, measures $0.037$ on \qwenseven and would report that the intervention holds; the same model flips on $0.852$ of items under P3. On \phimini , P1 and P3 both return exactly zero while P2 finds $0.160$. Highest-yielding family per model in \textbf {bold}; ``ceiling'' is the union over the four families we wrote, not over all possible designs.\relax }{table.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}E4: live replication on real open-weights LLMs}{10}{subsection.4.5}\protected@file@percent }
\newlabel{sec:e4}{{4.5}{10}{E4: live replication on real open-weights LLMs}{subsection.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Flip rate by pressure design family\xspace  on three open-weights models, with and without the anti-sycophancy intervention. The spread across families within a single model is far larger than the spread across models within a family, which is what makes a single-family evaluation unsafe to interpret.\relax }}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:e4_families}{{5}{11}{Flip rate by pressure \family on three open-weights models, with and without the anti-sycophancy intervention. The spread across families within a single model is far larger than the spread across models within a family, which is what makes a single-family evaluation unsafe to interpret.\relax }{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {E4: probability that the protocol escapes the null} at matched budget (number of model calls; 400 replicates, intervention active). This is the quantity a safety team acts on. \textsc  {Static-P1}\xspace  on \textsc  {Phi-3.5-mini}\xspace  never escapes the null at any budget up to 200 calls even though 16\% of items are flippable, so its report of robustness is an artifact of the design, not a property of the model. Best per column block in \textbf  {bold}.\relax }}{11}{table.caption.13}\protected@file@percent }
\newlabel{tab:e4_detection}{{7}{11}{\textbf {E4: probability that the protocol escapes the null} at matched budget (number of model calls; 400 replicates, intervention active). This is the quantity a safety team acts on. \staticpone on \phimini never escapes the null at any budget up to 200 calls even though 16\% of items are flippable, so its report of robustness is an artifact of the design, not a property of the model. Best per column block in \textbf {bold}.\relax }{table.caption.13}{}}
\newlabel{fig:e4_null}{{6a}{12}{Probability of escaping the null\relax }{figure.caption.14}{}}
\newlabel{sub@fig:e4_null}{{a}{12}{Probability of escaping the null\relax }{figure.caption.14}{}}
\newlabel{fig:e4_items}{{6b}{12}{Fraction of vulnerable items localised\relax }{figure.caption.14}{}}
\newlabel{sub@fig:e4_items}{{b}{12}{Fraction of vulnerable items localised\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Live protocol race at matched call budget, 400 replicates. {\em  (a)}the coarse measure a safety team acts on: does the protocol report any flip at all? {\em  (b)}the finer measure: how much of the vulnerable set does it find? Adaptive allocation over design families\xspace  dominates both, and the gap is largest on \textsc  {Qwen2.5-7B}\xspace  , where the design-quality spread is widest.\relax }}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:e4_protocols}{{6}{12}{Live protocol race at matched call budget, 400 replicates. \captiona the coarse measure a safety team acts on: does the protocol report any flip at all? \captionb the finer measure: how much of the vulnerable set does it find? Adaptive allocation over \families dominates both, and the gap is largest on \qwenseven , where the design-quality spread is widest.\relax }{figure.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Verdict on the three claims contained in the hypothesis. The hypothesis is right about the conclusion and wrong about the mechanism, and the correction is practically consequential.\relax }}{12}{table.caption.15}\protected@file@percent }
\newlabel{tab:verdict}{{8}{12}{Verdict on the three claims contained in the hypothesis. The hypothesis is right about the conclusion and wrong about the mechanism, and the correction is practically consequential.\relax }{table.caption.15}{}}
