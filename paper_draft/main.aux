\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {E1: detection rate at matched iteration budget} on 50 \textsc  {Llama-2-7B-chat}\xspace  behaviours. \textsc  {Static-d0}\xspace  , the default design, detects nothing across four orders of magnitude of budget, while every arm that searches more than one design family\xspace  detects most or all behaviours. \textsc  {Ladder}\xspace  , which uses the null as a switch trigger, never beats \textsc  {Fixed-Split}\xspace  , which switches on a blind schedule with the same budget and the same designs. \textsc  {Oracle}\xspace  is an upper bound (best family per behaviour) and is not a deployable protocol. Best deployable arm per row in \textbf  {bold}.\relax }}{6}{table.caption.3}\protected@file@percent }
\newlabel{tab:e1_detection}{{2}{6}{\textbf {E1: detection rate at matched iteration budget} on 50 \llamaseven behaviours. \staticzero , the default design, detects nothing across four orders of magnitude of budget, while every arm that searches more than one \family detects most or all behaviours. \ladder , which uses the null as a switch trigger, never beats \fixedsplit , which switches on a blind schedule with the same budget and the same designs. \oracle is an upper bound (best family per behaviour) and is not a deployable protocol. Best deployable arm per row in \textbf {bold}.\relax }{table.caption.3}{}}
